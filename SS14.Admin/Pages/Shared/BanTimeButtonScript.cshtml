<script>
{
    let durationInput = document.getElementById("durationInput");
    let durationSummary = document.getElementById("durationSummary");
    let parseDuration = function() {
        let value = Number(durationInput.value);
        return Number.isFinite(value) ? value : 0;
    };

    let formatPart = function(value, unit) {
        return `${value} ${unit}${value === 1 ? "" : "s"}`;
    };

    let formatDuration = function(totalMinutes) {
        if (totalMinutes === 0)
            return "Permanent";

        let remaining = Math.abs(totalMinutes);
        let days = Math.floor(remaining / 1440);
        remaining -= days * 1440;
        let hours = Math.floor(remaining / 60);
        remaining -= hours * 60;
        let minutes = remaining;
        let parts = [];

        if (days > 0)
            parts.push(formatPart(days, "day"));

        if (hours > 0)
            parts.push(formatPart(hours, "hour"));

        if (minutes > 0 || parts.length === 0)
            parts.push(formatPart(minutes, "minute"));

        let formatted = parts.join(", ");
        return totalMinutes < 0 ? `-${formatted}` : formatted;
    };

    let updateButtons = function() {
        for (const btn of document.querySelectorAll(".durationButton")) {
            let label = btn.dataset.label;
            let direction = Number(btn.dataset.duration) < 0 ? "-" : "+";
            btn.innerText = `${direction}${label}`;
        }

        if (durationSummary)
            durationSummary.innerText = `Current duration: ${formatDuration(parseDuration())}`;
    };

    durationInput.addEventListener("change", () => {
        updateButtons();
    });

    durationInput.addEventListener("input", () => {
        updateButtons();
    });

    for (const btn of document.querySelectorAll(".durationButton")) {
        let dur = Number(btn.dataset.duration);
        btn.addEventListener("click", e => {
            durationInput.value = Math.max(0, parseDuration() + dur).toString();
            updateButtons();
            e.preventDefault();
        });
    }

    updateButtons();
}
</script>
