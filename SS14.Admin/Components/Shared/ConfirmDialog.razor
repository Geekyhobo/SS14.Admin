@*
    Confirmation modal.
*@
@if (IsVisible)
{
    <div class="modal-backdrop" @onclick="Cancel" role="dialog" aria-modal="true" aria-labelledby="confirm-dialog-title">
        <div class="modal-panel" @onclick:stopPropagation="true">
            <div class="p-6">
                <h3 id="confirm-dialog-title" class="text-xl font-bold mb-4 text-gray-900 dark:text-white">@Title</h3>
                <p class="text-gray-700 dark:text-gray-300 mb-6">@Message</p>

                <div class="flex flex-wrap gap-3 justify-end">
                    <button
                        @onclick="Cancel"
                        type="button"
                        class="min-h-touch px-4 py-2 bg-gray-300 dark:bg-gray-600 text-gray-800 dark:text-white rounded hover:bg-gray-400 dark:hover:bg-gray-500 transition-colors focus-ring">
                        @CancelText
                    </button>
                    <button
                        @onclick="Confirm"
                        type="button"
                        class="min-h-touch px-4 py-2 @ConfirmButtonClass rounded hover:opacity-90 transition-colors focus-ring">
                        @ConfirmText
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public string Title { get; set; } = "Confirm Action";
    [Parameter] public string Message { get; set; } = "Are you sure you want to proceed?";
    [Parameter] public string ConfirmText { get; set; } = "Confirm";
    [Parameter] public string CancelText { get; set; } = "Cancel";
    [Parameter] public string ConfirmButtonClass { get; set; } = "bg-red-600 text-white hover:bg-red-700";
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task Confirm()
    {
        IsVisible = false;
        await OnConfirm.InvokeAsync();
    }

    private async Task Cancel()
    {
        IsVisible = false;
        await OnCancel.InvokeAsync();
    }
}
