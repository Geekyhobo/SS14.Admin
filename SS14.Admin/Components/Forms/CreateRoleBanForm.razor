@using Content.Shared.Database

<EditForm Model="@_model" OnValidSubmit="Submit" FormName="CreateRoleBanForm" class="max-w-4xl mx-auto p-6 bg-white dark:bg-gray-800 rounded-lg shadow-md space-y-6">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-red-600 bg-red-50 dark:bg-red-900/20 p-3 rounded" />

    <!-- Name or User ID -->
    <div class="form-group">
        <label class="block text-sm font-semibold mb-2">Name or User ID</label>
        <InputText @bind-Value="_model.NameOrUid" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:ring-2 focus:ring-blue-500 dark:bg-gray-700" />
    </div>

    <!-- IP Address/CIDR -->
    <div class="form-group">
        <label class="block text-sm font-semibold mb-2">IP Address/CIDR</label>
        <div class="flex gap-3 items-center">
            <InputText @bind-Value="_model.IP" class="flex-1 px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:ring-2 focus:ring-blue-500 dark:bg-gray-700" />
            <label class="flex items-center gap-2 whitespace-nowrap">
                <InputCheckbox @bind-Value="_model.UseLatestIp" class="w-4 h-4" />
                <span class="text-sm">Use latest</span>
            </label>
        </div>
    </div>

    <!-- HWID -->
    <div class="form-group">
        <label class="block text-sm font-semibold mb-2">HWID</label>
        <div class="flex gap-3 items-center">
            <InputText @bind-Value="_model.HWid" class="flex-1 px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:ring-2 focus:ring-blue-500 dark:bg-gray-700" />
            <label class="flex items-center gap-2 whitespace-nowrap">
                <InputCheckbox @bind-Value="_model.UseLatestHwid" class="w-4 h-4" />
                <span class="text-sm">Use latest</span>
            </label>
        </div>
    </div>

    <!-- Role Selection -->
    <div class="form-group">
        <label class="block text-sm font-semibold mb-2">Roles</label>

        @* Selected roles as removable chips *@
        @if (_selectedRoles.Count > 0)
        {
            <div class="flex flex-wrap gap-1.5 mb-3">
                @foreach (var role in _selectedRoles)
                {
                    <span class="inline-flex items-center gap-1 rounded-full border px-2.5 py-1 text-xs font-medium"
                          style="@GetRoleBadgeStyle(role)">
                        @role
                        <button type="button" @onclick="() => RemoveRole(role)"
                                class="ml-0.5 hover:opacity-70 transition-opacity">
                            <i class="ri-close-line"></i>
                        </button>
                    </span>
                }
            </div>
        }

        @* role picker *@
        <details class="border border-gray-300 dark:border-gray-600 rounded-md">
            <summary class="px-3 py-2 cursor-pointer text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700/50 select-none">
                Select Roles (@_selectedRoles.Count selected)
            </summary>
            <div class="p-3 border-t border-gray-200 dark:border-gray-600 space-y-3 max-h-64 overflow-y-auto">
                @foreach (var dept in _departmentCatalog)
                {
                    <div>
                        <div class="flex items-center gap-2 mb-1.5">
                            <span class="text-xs font-bold uppercase tracking-wide text-gray-500 dark:text-gray-400">@dept.Key</span>
                            <button type="button" @onclick="() => ToggleDepartment(dept.Key)"
                                    class="text-[10px] font-medium px-1.5 py-0.5 rounded transition-colors"
                                    style="color: var(--color-info);">
                                @(IsDepartmentFullySelected(dept.Key) ? "Deselect all" : "Select all")
                            </button>
                        </div>
                        <div class="flex flex-wrap gap-1.5">
                            @foreach (var roleId in dept.Value)
                            {
                                var formatted = $"Job:{roleId}";
                                var isSelected = _selectedRoles.Contains(formatted);
                                <button type="button" @onclick="() => ToggleRole(formatted)"
                                        class="@($"inline-flex items-center rounded-full border px-2 py-0.5 text-[11px] font-medium transition-all {(isSelected ? "ring-2 ring-blue-400 dark:ring-blue-500 opacity-100" : "opacity-60 hover:opacity-100")}")">
                                    @roleId
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        </details>

        @* Manual role input*@
        <div class="mt-3 flex gap-2">
            <InputText @bind-Value="_manualRoleInput" placeholder="RoleType:RoleId (e.g. Job:Captain or Antag:Traitor)" class="flex-1 px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 text-sm" />
            <button type="button" @onclick="AddManualRole"
                    class="px-4 py-2 bg-gray-600 hover:bg-gray-700 text-white text-sm font-medium rounded-md transition">
                Add
            </button>
        </div>
        @if (_roleError != null)
        {
            <p class="mt-1 text-sm text-red-600 dark:text-red-400">@_roleError</p>
        }
    </div>

    <!-- Duration -->
    <div class="form-group">
        <label class="block text-sm font-semibold mb-2">Minutes (0: Permanent)</label>
        @* Stacks on mobile *@
        <div class="flex flex-col gap-3 md:flex-row">
            <div class="flex-1">
                <InputNumber @bind-Value="_model.LengthMinutes" @bind-Value:event="oninput" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:ring-2 focus:ring-blue-500 dark:bg-gray-700" />
                <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">Current duration: @DurationSummary</p>
            </div>
            <div class="flex flex-wrap gap-2">
                @foreach (var adjustment in DurationAdjustments)
                {
                    <button type="button" @onclick="() => AdjustDuration(-adjustment.Minutes)"
                            class="px-3 py-2 bg-red-100 text-red-800 dark:bg-red-900/40 dark:text-red-200 hover:bg-red-200 dark:hover:bg-red-900/60 rounded">-@adjustment.Label</button>
                    <button type="button" @onclick="() => AdjustDuration(adjustment.Minutes)"
                            class="px-3 py-2 bg-green-100 text-green-800 dark:bg-green-900/40 dark:text-green-200 hover:bg-green-200 dark:hover:bg-green-900/60 rounded">+@adjustment.Label</button>
                }
            </div>
        </div>
    </div>

    <!-- Reason -->
    <div class="form-group">
        <label class="block text-sm font-semibold mb-2">Reason</label>
        <InputTextArea @bind-Value="_model.Reason" rows="4" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:ring-2 focus:ring-blue-500 dark:bg-gray-700" />
    </div>

    <!-- Severity -->
    <div class="form-group">
        <label class="block text-sm font-semibold mb-2">Severity</label>
        <InputSelect @bind-Value="_model.Severity" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:ring-2 focus:ring-blue-500 dark:bg-gray-700">
            @foreach (var severity in Enum.GetValues<NoteSeverity>())
            {
                <option value="@severity">@severity</option>
            }
        </InputSelect>
    </div>

    <!-- Settings -->
    <div class="form-group">
        <fieldset class="border border-gray-300 dark:border-gray-600 rounded-md p-4">
            <legend class="text-sm font-semibold px-2">Settings</legend>
            <div class="flex items-center gap-2">
                <InputCheckbox @bind-Value="_model.Hidden" id="hidden-checkbox" class="w-4 h-4" />
                <label for="hidden-checkbox" class="text-sm">Hidden from player</label>
            </div>
        </fieldset>
    </div>

    <div class="flex gap-3 pt-4">
        <button type="submit" class="px-6 py-2 bg-orange-600 hover:bg-orange-700 text-white font-semibold rounded-md shadow transition">
            Create Role Ban
        </button>
        <button type="button" @onclick='() => NavigationManager.NavigateTo("/rolebans")'
                class="px-6 py-2 bg-gray-300 dark:bg-gray-700 hover:bg-gray-400 dark:hover:bg-gray-600 font-semibold rounded-md shadow transition">
            Cancel
        </button>
    </div>
</EditForm>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="bg-red-100 dark:bg-red-900/30 border-l-4 border-red-500 text-red-700 dark:text-red-300 p-4 rounded mt-4 max-w-4xl mx-auto">
        <p class="font-semibold">Error</p>
        <p>@_errorMessage</p>
    </div>
}
@if (!string.IsNullOrEmpty(_successMessage))
{
    <div class="bg-green-100 dark:bg-green-900/30 border-l-4 border-green-500 text-green-700 dark:text-green-300 p-4 rounded mt-4 max-w-4xl mx-auto">
        <p class="font-semibold">Success</p>
        <p>@_successMessage</p>
    </div>
}
