<EditForm Model="@Filter" FormName="@FormName" OnSubmit="@Submit" class="space-y-3">
    <!-- Row 1: Text search fields -->
    <div class="grid grid-cols-1 sm:grid-cols-[1fr_12rem] gap-3">
        <div class="flex flex-col gap-1">
            <label for="filter-search" class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Search</label>
            <InputText @bind-Value="Filter.Search"
                       id="filter-search"
                       placeholder="Username, GUID, IP, HWID, Role, Reason"
                       class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-gray-100 text-sm" />
        </div>
        <div class="flex flex-col gap-1">
            <label for="filter-role" class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Role</label>
            <InputText @bind-Value="Filter.RoleFilter"
                       id="filter-role"
                       placeholder="Filter by role"
                       class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-gray-100 text-sm" />
        </div>
    </div>

    <!-- Row 2: Date range filters -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
        <div class="flex flex-col gap-1">
            <label for="filter-date-from" class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Ban Date From</label>
            <InputDate @bind-Value="Filter.DateFrom"
                       id="filter-date-from"
                       class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-gray-100 text-sm" />
        </div>
        <div class="flex flex-col gap-1">
            <label for="filter-date-to" class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Ban Date To</label>
            <InputDate @bind-Value="Filter.DateTo"
                       id="filter-date-to"
                       class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-gray-100 text-sm" />
        </div>
        <div class="flex flex-col gap-1">
            <label for="filter-expires-from" class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Expires From</label>
            <InputDate @bind-Value="Filter.ExpiresFrom"
                       id="filter-expires-from"
                       class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-gray-100 text-sm" />
        </div>
        <div class="flex flex-col gap-1">
            <label for="filter-expires-to" class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Expires To</label>
            <InputDate @bind-Value="Filter.ExpiresTo"
                       id="filter-expires-to"
                       class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-gray-100 text-sm" />
        </div>
    </div>

    <!-- Row 3: Status toggles + Search button -->
    <div class="flex flex-wrap items-center justify-between gap-3 pt-1">
        <div class="flex gap-4 items-center border border-gray-200 dark:border-gray-600 rounded-lg px-4 py-2 bg-gray-50 dark:bg-gray-700/50">
            <span class="font-semibold text-gray-700 dark:text-gray-300 text-sm">Status:</span>
            <label class="flex items-center gap-2 cursor-pointer">
                <InputCheckbox @bind-Value="Filter.ShowActive" id="show-active"
                               class="w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded focus:ring-blue-500 dark:focus:ring-blue-600 dark:ring-offset-gray-800" />
                <span class="text-sm text-gray-700 dark:text-gray-300">Active</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
                <InputCheckbox @bind-Value="Filter.ShowExpired" id="show-expired"
                               class="w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded focus:ring-blue-500 dark:focus:ring-blue-600 dark:ring-offset-gray-800" />
                <span class="text-sm text-gray-700 dark:text-gray-300">Expired/Unbanned</span>
            </label>
        </div>
        <button type="submit" class="inline-flex items-center h-10 px-6 py-2 bg-gradient-to-r from-sky-500 to-sky-600 hover:from-sky-600 hover:to-sky-700 dark:from-sky-600 dark:to-sky-700 dark:hover:from-sky-700 dark:hover:to-sky-800 text-white rounded-lg font-medium shadow-md transition-all duration-200 text-sm">
            <i class="ri-search-line mr-2"></i>Search
        </button>
    </div>
</EditForm>

@code
{
    [Parameter] public RoleBansFilterModel Filter { get; set; } = null!;
    [Parameter] public string FormName { get; set; } = null!;
    [Parameter] public EventCallback<EditContext> OnSubmit { get; set; } = EventCallback<EditContext>.Empty;

    private async Task Submit(EditContext arg) => await OnSubmit.InvokeAsync(arg);
}
