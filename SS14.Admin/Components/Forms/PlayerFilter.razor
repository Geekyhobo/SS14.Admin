<EditForm Model="@Filter" FormName="@FormName" OnSubmit="@Submit" class="filter-bar">
    <div class="filter-field-lg">
        <label for="filter-search" class="filter-label">Search</label>
        <InputText @bind-Value="Filter.Search"
                   id="filter-search"
                   placeholder="Username, GUID, IP, HWID"
                   class="filter-input" />
    </div>
    @*<div class="flex flex-col gap-1">
        <label for="filter-first-seen-from" class="text-sm font-semibold text-gray-700 dark:text-gray-300">First Seen From</label>
        <InputDate @bind-Value="Filter.FirstSeenFrom" id="filter-first-seen-from" class="px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-gray-100" />
    </div>
    <div class="flex flex-col gap-1">
        <label for="filter-first-seen-to" class="text-sm font-semibold text-gray-700 dark:text-gray-300">First Seen To</label>
        <InputDate @bind-Value="Filter.FirstSeenTo" id="filter-first-seen-to" class="px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-gray-100" />
    </div>
    <div class="flex flex-col gap-1">
        <label for="filter-last-seen-from" class="text-sm font-semibold text-gray-700 dark:text-gray-300">Last Seen From</label>
        <InputDate @bind-Value="Filter.LastSeenFrom" id="filter-last-seen-from" class="px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-gray-100" />
    </div>
    <div class="flex flex-col gap-1">
        <label for="filter-last-seen-to" class="text-sm font-semibold text-gray-700 dark:text-gray-300">Last Seen To</label>
        <InputDate @bind-Value="Filter.LastSeenTo" id="filter-last-seen-to" class="px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-gray-100" />
    </div>*@
    <button type="submit" class="btn-filter-submit">
        <i class="ri-search-line mr-2"></i>Search
    </button>
</EditForm>

@code
{
    [Parameter] public PlayerFilterModel Filter { get; set; } = null!;
    [Parameter] public string FormName { get; set; } = null!;
    [Parameter] public EventCallback<EditContext> OnSubmit { get; set; } = EventCallback<EditContext>.Empty;

    private async Task Submit(EditContext arg) => await OnSubmit.InvokeAsync(arg);
}
