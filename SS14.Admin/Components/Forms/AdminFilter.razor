<EditForm Model="@Filter" FormName="@FormName" OnSubmit="@Submit" class="filter-bar">
    <div class="filter-field">
        <label for="filter-search" class="filter-label">Search Username</label>
        <InputText @bind-Value="Filter.Search"
                   id="filter-search"
                   placeholder="Username..."
                   class="filter-input" />
    </div>
    <div class="filter-field">
        <label for="filter-rank" class="filter-label">Rank</label>
        <InputText @bind-Value="Filter.Rank"
                   id="filter-rank"
                   placeholder="Rank..."
                   class="filter-input" />
    </div>
    <button type="submit" class="btn-filter-submit">
        <i class="ri-search-line mr-2"></i>Search
    </button>
</EditForm>

@code
{
    [Parameter] public AdminFilterModel Filter { get; set; } = null!;
    [Parameter] public string FormName { get; set; } = null!;
    [Parameter] public EventCallback<EditContext> OnSubmit { get; set; } = EventCallback<EditContext>.Empty;

    private async Task Submit(EditContext arg) => await OnSubmit.InvokeAsync(arg);
}
