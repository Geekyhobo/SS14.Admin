@using Content.Server.Database
@using Content.Shared.Database

<EditForm Model="@Filter" FormName="@FormName" OnSubmit="@Submit" class="filter-bar">
    <div class="filter-field">
        <label for="filter-search" class="filter-label">Search</label>
        <InputText @bind-Value="Filter.Search"
                   id="filter-search"
                   placeholder="Search logs..."
                   class="filter-input" />
    </div>
    <div class="filter-field">
        <label for="filter-type" class="filter-label">Type</label>
        <InputSelect @bind-Value="Filter.Type"
                     id="filter-type"
                     class="filter-input">
            <option selected="@(Filter.Type == null)" value="">All</option>
            @foreach (var type in Enum.GetValues(typeof(LogType)))
            {
                <option selected="@(type.Equals(Filter.Type))" value="@type">@type</option>
            }
        </InputSelect>
    </div>
    <div class="filter-field">
        <label for="filter-impact" class="filter-label">Impact</label>
        <InputSelect @bind-Value="Filter.Impact"
                     id="filter-impact"
                     class="filter-input">
            <option selected="@(Filter.Impact == null)" value="">All</option>
            @foreach (var impact in Enum.GetValues(typeof(LogImpact)))
            {
                <option selected="@(impact.Equals(Filter.Impact))" value="@impact">@impact</option>
            }
        </InputSelect>
    </div>
    <div class="filter-field-sm">
        <label for="filter-round-id" class="filter-label">Round Id</label>
        <InputNumber @bind-Value="Filter.RoundId"
                     id="filter-round-id"
                     class="filter-input" />
    </div>
    <div class="filter-field">
        <label for="filter-server" class="filter-label">Server</label>
        <InputSelect @bind-Value="Filter.ServerId"
                     id="filter-server"
                     class="filter-input">
            <option selected="@(Filter.ServerId == null)" value="">All</option>
            @foreach (var server in Servers)
            {
                <option value="@server.Id">@server.Name</option>
            }
        </InputSelect>
    </div>
    <div class="filter-field">
        <label for="filter-player" class="filter-label">Player</label>
        <InputText @bind-Value="Filter.PlayerName"
                   id="filter-player"
                   placeholder="Username"
                   class="filter-input" />
    </div>
    <div class="filter-field">
        <label class="filter-label">Date Range</label>
        <DatePicker @bind-DateFrom="Filter.DateFrom" @bind-DateTo="Filter.DateTo" />
    </div>
    <button type="submit" class="btn-filter-submit">
        <i class="ri-search-line mr-2"></i>Search
    </button>
</EditForm>

@code
{
    [Parameter] public LogsFilterModel Filter { get; set; } = null!;
    [Parameter] public List<Server> Servers { get; set; } = new();
    [Parameter] public string FormName { get; set; } = null!;
    [Parameter] public EventCallback<EditContext> OnSubmit { get; set; } = EventCallback<EditContext>.Empty;

    private async Task Submit(EditContext arg) => await OnSubmit.InvokeAsync(arg);

}
