@page "/logs"
@using Microsoft.AspNetCore.Components.QuickGrid
@using SS14.Admin.AdminLogs
@using SS14.Admin.Components.Forms


<PageTitle>Logs</PageTitle>

<div class="w-full">
    <!-- Page Header -->
    <div class="page-header px-4 sm:px-6 pt-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 flex items-center gap-3">
                <i class="ri-file-list-3-fill text-yellow-600 dark:text-yellow-500"></i>
                Admin Logs
            </h1>
            <p class="text-gray-500 dark:text-gray-400 mt-1 text-sm">View and search administration logs</p>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="px-4 sm:px-6 mb-4">
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow overflow-hidden">
            <div class="p-3">
                <LogFilter Filter="@_filter" Servers="@_servers" FormName="LogsPageFilterForm" OnSubmit="RefreshFilter" />
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_queryError))
    {
        <div class="px-4 sm:px-6 mb-4">
            <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-3 flex items-start gap-3">
                <i class="ri-error-warning-line text-red-500 text-lg mt-0.5"></i>
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-semibold text-red-800 dark:text-red-300">Query failed</p>
                    <p class="text-sm text-red-600 dark:text-red-400 mt-0.5 break-words">@_queryError</p>
                </div>
            </div>
        </div>
    }

    <!-- Logs Table -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow overflow-hidden mx-4 sm:mx-6 mb-4">
        <div class="overflow-x-auto">
            <QuickGrid
                @ref="Grid"
                ItemsProvider="@_logsProvider"
                Pagination="@_pagination"
                Class="w-full text-sm">

                <TemplateColumn Title="Round" class="text-gray-700 dark:text-gray-300 px-4 py-2 whitespace-nowrap">
                    <div class="cursor-pointer" @onclick="() => OpenLogDetails(context)">
                        @context.RoundId
                    </div>
                </TemplateColumn>
                <TemplateColumn Title="Server" class="text-gray-700 dark:text-gray-300 px-4 py-2 whitespace-nowrap">
                    <div class="cursor-pointer" @onclick="() => OpenLogDetails(context)">
                        @context.ServerName
                    </div>
                </TemplateColumn>
                <TemplateColumn Title="Impact" class="px-4 py-2 whitespace-nowrap">
                    <div class="cursor-pointer" @onclick="() => OpenLogDetails(context)">
                        <span class="@context.Impact.CssColorClass("text") @context.Impact.CssColorClass("bg") px-2 py-0.5 rounded font-bold text-xs">
                            @context.Impact
                        </span>
                    </div>
                </TemplateColumn>
                <TemplateColumn Title="Date" class="text-gray-600 dark:text-gray-400 px-4 py-2 whitespace-nowrap">
                    <div class="cursor-pointer" @onclick="() => OpenLogDetails(context)">
                        @context.Date.ToString("yyyy-MM-dd HH:mm:ss")
                    </div>
                </TemplateColumn>
                <TemplateColumn Title="Type" class="text-gray-600 dark:text-gray-400 px-4 py-2 whitespace-nowrap">
                    <div class="cursor-pointer font-mono text-xs" @onclick="() => OpenLogDetails(context)">
                        @context.Type
                    </div>
                </TemplateColumn>
                <TemplateColumn Title="Message" class="text-gray-600 dark:text-gray-400 px-4 py-2">
                    <div class="truncate max-w-md cursor-pointer" @onclick="() => OpenLogDetails(context)">
                        @context.Message
                    </div>
                </TemplateColumn>
            </QuickGrid>
        </div>
        <div class="bg-gray-50 dark:bg-gray-700/50 border-t border-gray-200 dark:border-gray-700 px-4 py-2">
            <Pagination OnRefreshRequired="Refresh" ShowPerPage="false" State="@_pagination" />
        </div>
    </div>
</div>

<!-- Log Details Drawer -->
<LogDetailsDrawer
    IsOpen="_isDrawerOpen"
    IsOpenChanged="DrawerOpenChanged"
    LogDetails="_selectedLogDetails"
    IsLoading="_isLoadingLogDetails"
    HasError="_hasLogDetailsError"
    ErrorMessage="_logDetailsError" />
