@using System.Text.Json
@using Content.Shared.Database
@using SS14.Admin.AdminLogs

@if (IsOpen)
{
    <!-- Click anywhere to close overlay -->
    <div
        class="fixed inset-0 bg-black/20 dark:bg-black/40 z-40"
        @onclick="Close">
    </div>

    <!-- Drawer -->
    <div
        class="fixed top-0 right-0 h-full w-full max-w-xl bg-white dark:bg-gray-800 shadow-2xl z-50 transform transition-transform duration-300 ease-out overflow-hidden flex flex-col"
        style="animation: slideInRight 300ms ease-out forwards;">

        <!-- Header -->
        <div class="flex items-center justify-between p-4 border-b-2 @ImpactBorderClass @ImpactBgClass">
            <div>
                <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100">
                    Log Details
                </h2>
                @if (LogDetails != null)
                {
                    <span class="@ImpactTextClass @ImpactBadgeBgClass text-xs font-bold px-2 py-0.5 rounded mt-1 inline-block">
                        @LogDetails.Impact
                    </span>
                }
            </div>
            <button
                type="button"
                class="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
                @onclick="Close">
                <i class="ri-close-line text-xl text-gray-700 dark:text-gray-300"></i>
            </button>
        </div>

        <!-- Content -->
        <div class="flex-1 overflow-y-auto p-4 space-y-4">
            @if (IsLoading)
            {
                <!-- Loading State -->
                <div class="flex items-center justify-center h-64">
                    <div class="flex flex-col items-center gap-4">
                        <div class="w-12 h-12 border-4 border-red-500 border-t-transparent rounded-full animate-spin"></div>
                        <p class="text-gray-500 dark:text-gray-400">Loading...</p>
                    </div>
                </div>
            }
            else if (HasError)
            {
                <!-- Error State -->
                <div class="flex flex-col items-center justify-center h-64 text-center">
                    <div class="w-16 h-16 rounded-full bg-red-100 dark:bg-red-900/30 flex items-center justify-center mb-4">
                        <i class="ri-error-warning-line text-3xl text-red-600 dark:text-red-400"></i>
                    </div>
                    <p class="text-lg font-semibold text-gray-900 dark:text-gray-100">Error Loading Details</p>
                    <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">@ErrorMessage</p>
                    <button
                        class="mt-4 px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors"
                        @onclick="Close">
                        Close
                    </button>
                </div>
            }
            else if (LogDetails != null)
            {
                <!-- Basic Info -->
                <div class="bg-gray-50 dark:bg-gray-700/50 rounded-lg p-4 space-y-3">
                    <div class="grid grid-cols-[100px_1fr] gap-2">
                        <span class="text-sm font-semibold text-gray-500 dark:text-gray-400">Server:</span>
                        <span class="text-gray-900 dark:text-gray-100">@(LogDetails.ServerName ?? "Unknown")</span>
                    </div>
                    <div class="grid grid-cols-[100px_1fr] gap-2">
                        <span class="text-sm font-semibold text-gray-500 dark:text-gray-400">Round:</span>
                        <span class="text-gray-900 dark:text-gray-100">#@LogDetails.RoundId</span>
                    </div>
                    <div class="grid grid-cols-[100px_1fr] gap-2">
                        <span class="text-sm font-semibold text-gray-500 dark:text-gray-400">Log ID:</span>
                        <span class="text-gray-900 dark:text-gray-100 font-mono text-sm">@LogDetails.Id</span>
                    </div>
                    <div class="grid grid-cols-[100px_1fr] gap-2">
                        <span class="text-sm font-semibold text-gray-500 dark:text-gray-400">Date:</span>
                        <span class="text-gray-900 dark:text-gray-100">@LogDetails.Date.ToString("yyyy-MM-dd HH:mm:ss")</span>
                    </div>
                    <div class="grid grid-cols-[100px_1fr] gap-2">
                        <span class="text-sm font-semibold text-gray-500 dark:text-gray-400">Type:</span>
                        <span class="text-gray-900 dark:text-gray-100 font-mono text-sm">@LogDetails.Type</span>
                    </div>
                    <div class="grid grid-cols-[100px_1fr] gap-2">
                        <span class="text-sm font-semibold text-gray-500 dark:text-gray-400">Impact:</span>
                        <span class="@LogDetails.Impact.CssColorClass("text") font-bold text-sm">@LogDetails.Impact</span>
                    </div>
                </div>

                <!-- Players -->
                @if (LogDetails.Players?.Count > 0)
                {
                    <div>
                        <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-2 flex items-center gap-2">
                            <i class="ri-group-line text-red-500"></i>
                            Players (@LogDetails.Players.Count)
                        </h3>
                        <div class="bg-gray-50 dark:bg-gray-700/50 rounded-lg p-2 space-y-1">
                            @foreach (var player in LogDetails.Players)
                            {
                                <a href="/players?player=@player.PlayerUsername"
                                   class="flex items-center gap-2 p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-600 transition-colors text-decoration-none">
                                    <i class="ri-user-line text-gray-500 dark:text-gray-400"></i>
                                    <span class="font-medium text-red-500">@player.PlayerUsername</span>
                                    <span class="text-xs text-gray-500 dark:text-gray-400 font-mono">@player.PlayerUserId</span>
                                </a>
                            }
                        </div>
                    </div>
                }

                <!-- Message -->
                <div>
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-2 flex items-center gap-2">
                        <i class="ri-chat-3-line text-red-500"></i>
                        Message
                    </h3>
                    <div class="bg-gray-50 dark:bg-gray-700/50 rounded-lg p-4">
                        <p class="text-gray-900 dark:text-gray-100 whitespace-pre-wrap break-words">@LogDetails.Message</p>
                    </div>
                </div>

                <!-- JSON Data -->
                <div>
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-2 flex items-center gap-2">
                        <i class="ri-code-s-slash-line text-red-500"></i>
                        Data
                    </h3>
                    <div class="bg-gray-50 dark:bg-gray-700/50 rounded-lg p-4 overflow-x-auto">
                        <pre class="text-sm font-mono text-gray-900 dark:text-gray-100 whitespace-pre-wrap">@JsonContent</pre>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter]
    public AdminLogDetailsDto? LogDetails { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public bool HasError { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    private string ImpactBorderClass => LogDetails?.Impact switch
    {
        LogImpact.Low => "border-gray-400",
        LogImpact.Medium => "border-yellow-500",
        LogImpact.High => "border-orange-500",
        LogImpact.Extreme => "border-red-600",
        _ => "border-gray-300 dark:border-gray-600"
    };

    private string ImpactBgClass => LogDetails?.Impact switch
    {
        LogImpact.Low => "bg-gray-50 dark:bg-gray-700/50",
        LogImpact.Medium => "bg-yellow-50 dark:bg-yellow-900/20",
        LogImpact.High => "bg-orange-50 dark:bg-orange-900/20",
        LogImpact.Extreme => "bg-red-50 dark:bg-red-900/20",
        _ => "bg-gray-50 dark:bg-gray-700/50"
    };

    private string ImpactTextClass => LogDetails?.Impact.CssColorClass("text") ?? "text-gray-600";

    private string ImpactBadgeBgClass => LogDetails?.Impact.CssColorClass("bg") ?? "bg-gray-200";

    private string JsonContent
    {
        get
        {
            try
            {
                if (LogDetails?.Json == null)
                    return "{}";

                var raw = LogDetails.Json.RootElement.GetRawText();
                // Re-parse and pretty-print with indentation
                using var doc = JsonDocument.Parse(raw);
                return JsonSerializer.Serialize(doc.RootElement, new JsonSerializerOptions { WriteIndented = true });
            }
            catch
            {
                return "{}";
            }
        }
    }

    private async Task Close()
    {
        await IsOpenChanged.InvokeAsync(false);
    }
}
