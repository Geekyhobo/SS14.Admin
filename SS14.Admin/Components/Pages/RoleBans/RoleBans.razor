@page "/Rolebans"
@using Microsoft.AspNetCore.Components.QuickGrid
@using SS14.Admin.Admins
@using SS14.Admin.Helpers
@using SS14.Admin.Components.Forms

<PageTitle>Role Bans</PageTitle>

<div class="min-h-screen">
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-4 px-4 sm:px-6 pt-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 flex items-center gap-3">
                <i class="ri-user-forbid-fill text-orange-600 dark:text-orange-500"></i>
                Role Bans
            </h1>
            <p class="text-gray-500 dark:text-gray-400 mt-1 text-sm">Manage role-specific bans</p>
        </div>
        <div class="flex gap-3">
            <AuthorizeView Roles="@AdminFlags.Ban.RoleName()">
                <Authorized>
                    <NavLink href="/rolebans/create"
                             class="inline-flex items-center px-3 py-1.5 bg-gradient-to-r from-orange-600 to-orange-700 hover:from-orange-700 hover:to-orange-800 dark:from-orange-700 dark:to-orange-800 dark:hover:from-orange-800 dark:hover:to-orange-900 text-white rounded-lg font-medium shadow-md transition-all duration-200 text-sm">
                        <i class="ri-shield-keyhole-fill mr-2"></i>
                        New Role Ban
                    </NavLink>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="px-4 sm:px-6 mb-4">
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow overflow-hidden">
            <div class="p-3">
                <RoleBanFilter Filter="_model" FormName="roleBanFilter" OnSubmit="@OnFilterSubmit" />
            </div>
        </div>
    </div>

    <!-- Column Visibility Toggles -->
    <div class="px-4 sm:px-6 mb-4 flex flex-wrap items-center gap-2">
        <span class="text-sm text-gray-600 dark:text-gray-400 font-medium">Identity fields:</span>
        <button @onclick="() => _showIpColumn = !_showIpColumn"
                class="inline-flex items-center px-2 py-1 rounded text-xs font-medium transition-colors @(_showIpColumn ? "bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300" : "bg-gray-100 dark:bg-gray-700 text-gray-500 dark:text-gray-400")">
            <i class="@(_showIpColumn ? "fas fa-check-square mr-1" : "far fa-square mr-1")"></i>
            IP
        </button>
        <button @onclick="() => _showHwidColumn = !_showHwidColumn"
                class="inline-flex items-center px-2 py-1 rounded text-xs font-medium transition-colors @(_showHwidColumn ? "bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300" : "bg-gray-100 dark:bg-gray-700 text-gray-500 dark:text-gray-400")">
            <i class="@(_showHwidColumn ? "fas fa-check-square mr-1" : "far fa-square mr-1")"></i>
            HWID
        </button>
        <button @onclick="() => _showGuidColumn = !_showGuidColumn"
                class="inline-flex items-center px-2 py-1 rounded text-xs font-medium transition-colors @(_showGuidColumn ? "bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300" : "bg-gray-100 dark:bg-gray-700 text-gray-500 dark:text-gray-400")">
            <i class="@(_showGuidColumn ? "fas fa-check-square mr-1" : "far fa-square mr-1")"></i>
            GUID
        </button>
    </div>

    <!-- Role Bans Table -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow overflow-hidden mx-4 sm:mx-6 mb-4">
        <div class="overflow-x-auto">
            <QuickGrid TItem="RoleBanViewModel"
                       @ref="Grid"
                       Items="@_roleBansList.AsQueryable()"
                       Pagination="@_pagination"
                       RowClass="@GetRowClass"
                       Class="w-full text-sm">
                <TemplateColumn Title="Subject" class="px-3 py-3 align-top">
                    <div class="min-w-[15rem] max-w-[21rem]">
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="text-sm font-semibold text-gray-900 dark:text-gray-100">@context.PrimaryName</span>
                            @if (context.AdditionalPlayerCount > 0)
                            {
                                <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-[11px] font-medium text-gray-600 dark:bg-gray-700/70 dark:text-gray-300">
                                    +@context.AdditionalPlayerCount more
                                </span>
                            }
                            <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-semibold ring-1 ring-inset @GetStatusBadgeClass(context)">
                                @context.StatusLabel
                            </span>
                        </div>
                        @if (context.PlayerNames.Length > 1)
                        {
                            <div class="mt-2 flex flex-wrap gap-1">
                                @foreach (var name in context.PlayerNames.Skip(1).Take(3))
                                {
                                    <span class="inline-flex items-center rounded-md bg-gray-100 px-2 py-0.5 text-[11px] text-gray-600 dark:bg-gray-700/70 dark:text-gray-300">
                                        @name
                                    </span>
                                }
                                @if (context.PlayerNames.Length > 4)
                                {
                                    <span class="inline-flex items-center rounded-md bg-gray-100 px-2 py-0.5 text-[11px] text-gray-600 dark:bg-gray-700/70 dark:text-gray-300">
                                        +@(context.PlayerNames.Length - 4) more
                                    </span>
                                }
                            </div>
                        }
                        @if (context.Rounds.Length > 0)
                        {
                            <div class="mt-2 flex flex-wrap gap-1">
                                @foreach (var round in context.Rounds.Take(3))
                                {
                                    <span class="inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-[11px] font-medium text-amber-800 dark:bg-amber-900/30 dark:text-amber-200">
                                        Round #@round
                                    </span>
                                }
                                @if (context.Rounds.Length > 3)
                                {
                                    <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-[11px] font-medium text-gray-600 dark:bg-gray-700/70 dark:text-gray-300">
                                        +@(context.Rounds.Length - 3) more
                                    </span>
                                }
                            </div>
                        }
                    </div>
                </TemplateColumn>

                @* ── Roles column: department grouping── *@
                <TemplateColumn Title="Roles" class="px-3 py-3 align-top">
                    @{
                        var info = context.DisplayInfo;
                        var expanded = IsRoleExpanded(context.Id);
                        var hasOverflow = info.TotalCount > 3;
                    }
                    <div class="min-w-[14rem] max-w-[22rem]">
                        <div class="flex flex-wrap gap-1">
                            @* Department-wide chips*@
                            @foreach (var dept in info.FullDepartments)
                            {
                                <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-[11px] font-semibold"
                                      style="@GetDepartmentBadgeStyle(dept)">
                                    <i class="ri-building-2-line mr-1 text-[10px]"></i>
                                    @DepartmentLabels[dept]
                                </span>
                            }

                            @* Individual role chips — subdued, no icon, tighter *@
                            @if (expanded || !hasOverflow)
                            {
                                @foreach (var role in info.IndividualRoles)
                                {
                                    <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-[11px] font-medium opacity-85"
                                          style="@GetRoleBadgeStyle(role)">
                                        @ExtractRoleId(role)
                                    </span>
                                }
                            }
                            else
                            {
                                var visibleCount = Math.Max(3 - info.FullDepartments.Length, 0);
                                var visibleRoles = info.IndividualRoles.Take(visibleCount);
                                var hiddenCount = info.IndividualRoles.Length - visibleCount;
                                @foreach (var role in visibleRoles)
                                {
                                    <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-[11px] font-medium opacity-85"
                                          style="@GetRoleBadgeStyle(role)">
                                        @ExtractRoleId(role)
                                    </span>
                                }
                                @if (hiddenCount > 0)
                                {
                                    <button type="button"
                                            class="inline-flex items-center rounded-full border border-dashed border-gray-300 bg-gray-50 px-2 py-0.5 text-[11px] font-medium text-gray-500 transition-colors hover:bg-gray-200 hover:text-gray-700 dark:border-gray-600 dark:bg-gray-700/50 dark:text-gray-400 dark:hover:bg-gray-600 dark:hover:text-gray-200"
                                            @onclick="() => ToggleRoleExpansion(context.Id)">
                                        +@hiddenCount more
                                    </button>
                                }
                            }
                        </div>

                        @* Collapse control *@
                        @if (expanded && hasOverflow)
                        {
                            <div class="mt-1">
                                <button type="button"
                                        class="inline-flex items-center text-[11px] font-medium transition-colors text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300"
                                        @onclick="() => ToggleRoleExpansion(context.Id)">
                                    <i class="ri-arrow-up-s-line mr-0.5"></i>
                                    Show less
                                </button>
                            </div>
                        }
                    </div>
                </TemplateColumn>

                @if (ShowIdentityColumn)
                {
                    <TemplateColumn Title="Identifiers" class="px-3 py-3 align-top">
                        <div class="min-w-[18rem] max-w-[26rem] flex flex-wrap gap-1.5">
                            @if (_showGuidColumn)
                            {
                                @foreach (var guid in context.PlayerUserIds)
                                {
                                    <span class="inline-flex items-center rounded-md bg-gray-100 px-2 py-1 font-mono text-[11px] text-gray-700 dark:bg-gray-700/70 dark:text-gray-200">
                                        @RedactIdentity("GUID", guid)
                                    </span>
                                }
                            }
                            @if (_showIpColumn)
                            {
                                @foreach (var ip in context.IPAddresses)
                                {
                                    <span class="inline-flex items-center rounded-md bg-blue-50 px-2 py-1 font-mono text-[11px] text-blue-700 dark:bg-blue-900/20 dark:text-blue-200">
                                        @RedactIdentity("IP", ip)
                                    </span>
                                }
                            }
                            @if (_showHwidColumn)
                            {
                                @foreach (var hwid in context.Hwids)
                                {
                                    <span class="inline-flex items-center rounded-md bg-violet-50 px-2 py-1 font-mono text-[11px] text-violet-700 dark:bg-violet-900/20 dark:text-violet-200">
                                        @RedactIdentity("HWID", hwid)
                                    </span>
                                }
                            }
                        </div>
                    </TemplateColumn>
                }
                <TemplateColumn Title="Reason" class="px-3 py-3 align-top">
                    <div class="min-w-[16rem] max-w-[26rem]">
                        <div class="text-sm leading-5 text-gray-800 dark:text-gray-200 whitespace-normal break-words">@context.Reason</div>
                    </div>
                </TemplateColumn>
                <TemplateColumn Title="Timeline" class="px-3 py-3 align-top">
                    <div class="min-w-[11rem] space-y-1 text-xs">
                        <div class="flex items-baseline gap-1.5">
                            <span class="font-semibold uppercase tracking-wide text-[10px] text-gray-400 dark:text-gray-500 w-12 shrink-0">Ban</span>
                            <span class="text-[13px] font-medium text-gray-900 dark:text-gray-100">@context.BanTime.ToString("yyyy-MM-dd HH:mm")</span>
                        </div>
                        <div class="flex items-baseline gap-1.5">
                            <span class="font-semibold uppercase tracking-wide text-[10px] text-gray-400 dark:text-gray-500 w-12 shrink-0">Exp</span>
                            <span class="text-[13px] font-medium @(context.ExpirationTime.HasValue ? "text-gray-900 dark:text-gray-100" : "text-orange-600 dark:text-orange-400 font-semibold")">@context.ExpirationLabel</span>
                        </div>
                        <div class="flex items-baseline gap-1.5 pt-0.5 border-t border-gray-100 dark:border-gray-700/50">
                            <span class="font-semibold uppercase tracking-wide text-[10px] text-gray-400 dark:text-gray-500 w-12 shrink-0">By</span>
                            <span class="text-[13px] text-gray-600 dark:text-gray-300">@(string.IsNullOrWhiteSpace(context.Admin) ? "Unknown" : context.Admin)</span>
                        </div>
                    </div>
                </TemplateColumn>
                <TemplateColumn Title="Actions" class="px-3 py-3 align-top whitespace-nowrap">
                    <div class="flex justify-center min-w-[5.5rem]">
                    @if (context.Active)
                    {
                        @if (!_confirmations.ContainsKey(context.Id) || !_confirmations[context.Id])
                        {
                            <button class="inline-flex items-center justify-center gap-1.5 rounded-md bg-yellow-500 px-3.5 py-2 text-xs font-semibold text-white shadow-sm transition-colors hover:bg-yellow-600 dark:bg-yellow-600 dark:hover:bg-yellow-700"
                                    @onclick="() => ShowConfirmation(context.Id, context.Active)">
                                <i class="ri-lock-unlock-line text-sm"></i>
                                Unban
                            </button>
                        }
                        else
                        {
                            <button class="inline-flex items-center justify-center gap-1.5 rounded-md bg-red-500 px-3.5 py-2 text-xs font-semibold text-white shadow-sm ring-2 ring-red-300 dark:ring-red-800 transition-colors hover:bg-red-600 dark:bg-red-600 dark:hover:bg-red-700 animate-pulse-slow"
                                    @onclick="() => ConfirmAction(context.Id, context.Active)">
                                <i class="ri-error-warning-line text-sm"></i>
                                Confirm?
                            </button>
                        }
                    }
                    else
                    {
                        <span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-1 text-[11px] font-medium text-gray-400 dark:bg-gray-700/40 dark:text-gray-500">
                            @context.StatusLabel
                        </span>
                    }
                    </div>
                </TemplateColumn>
            </QuickGrid>
        </div>
        <div class="bg-gray-50 dark:bg-gray-700/50 border-t border-gray-200 dark:border-gray-700 px-4 py-2">
            <Pagination OnRefreshRequired="Refresh" State="@_pagination"/>
        </div>
    </div>
</div>
