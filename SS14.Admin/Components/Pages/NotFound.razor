@page "/not-found"
@using Microsoft.AspNetCore.Components.Routing
@layout Layout.MainLayout

<PageTitle>Not Found</PageTitle>

<div class="flex items-center justify-center px-4 sm:px-6"
     style="min-height: 60vh; min-height: 60dvh;">
    <div class="text-center max-w-md">
        <div class="mb-6">
            <span class="text-7xl font-bold text-gray-300 dark:text-gray-600">404</span>
        </div>
        <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-2">Page not found</h1>
        <p class="text-gray-500 dark:text-gray-400 mb-6">
            The page you're looking for doesn't exist or the requested resource could not be found.
        </p>
        <NavLink href="/"
                 class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white rounded-lg font-medium shadow-md transition-all duration-200 text-sm">
            <i class="ri-arrow-left-line mr-2"></i>
            Back to Home
        </NavLink>
    </div>
</div>
